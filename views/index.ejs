<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' };
  </script>
  <!--
    Cegah "flash" putih sebelum JS lain jalan: baca preferensi dark mode
    dari localStorage SEBELUM body di-render.
  -->
  <script>
    if (
      localStorage.getItem('theme') === 'dark' ||
      (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)
    ) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 min-h-screen transition-colors">

  <!-- NAVBAR -->
  <header class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-gray-800 dark:text-gray-100"><%= storeName %></h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Katalog produk & keranjang</p>
      </div>

      <div class="flex items-center gap-3">
        <!-- toggle dark/light mode -->
        <button
          id="theme-toggle"
          class="w-10 h-10 flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:opacity-80"
          title="Ganti tema"
        >
          <span id="theme-icon">🌙</span>
        </button>

        <!-- tombol wishlist, sama polanya kayak tombol keranjang: badge dari state -->
        <button
          id="wishlist-toggle"
          class="relative w-10 h-10 flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:opacity-80"
          title="Lihat produk favorit"
        >
          ❤️
          <span
            id="wishlist-badge"
            class="hidden absolute -top-1 -right-1 bg-pink-600 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center"
          >0</span>
        </button>

        <!-- tombol keranjang, angkanya (badge) di-render dari state, bukan hardcode -->
        <button
          id="cart-toggle"
          class="relative w-10 h-10 flex items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:opacity-80"
          title="Buka keranjang"
        >
          🛒
          <span
            id="cart-badge"
            class="hidden absolute -top-1 -right-1 bg-blue-600 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center"
          >0</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-6">
    <div class="flex flex-col gap-3 mb-4">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <h2 class="font-semibold text-gray-700 dark:text-gray-200">Produk Kami</h2>

        <div id="filter-buttons" class="flex gap-2 flex-wrap">
          <button data-filter="all" class="filter-btn px-3 py-1 text-sm rounded-lg bg-blue-600 text-white">Semua</button>
          <button data-filter="available" class="filter-btn px-3 py-1 text-sm rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Tersedia</button>
          <button data-filter="out" class="filter-btn px-3 py-1 text-sm rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Habis</button>
          <button data-filter="wishlist" class="filter-btn px-3 py-1 text-sm rounded-lg bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300">❤️ Favorit</button>
        </div>
      </div>

      <!-- search & sort: state baru (searchQuery, sortBy) di productStore, filter di client tanpa reload -->
      <div class="flex items-center gap-3 flex-wrap">
        <input
          id="search-input"
          type="text"
          placeholder="Cari produk..."
          class="flex-1 min-w-[180px] px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <select
          id="sort-select"
          class="px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="default">Urutan default</option>
          <option value="price-asc">Harga: Rendah ke Tinggi</option>
          <option value="price-desc">Harga: Tinggi ke Rendah</option>
        </select>
      </div>
    </div>

    <!-- render awal dari server (SSR), difilter ulang di client tanpa reload -->
    <div id="product-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% products.forEach(function(product) { %>
        <%- include('partials/product-card', { product }) %>
      <% }) %>
    </div>

    <p id="empty-state" class="hidden text-center text-gray-400 dark:text-gray-500 py-8">
      Gak ada produk yang cocok sama filter ini
    </p>
  </main>

  <!-- OVERLAY + DRAWER KERANJANG (murni client-rendered, isinya dari cartStore) -->
  <div id="cart-overlay" class="hidden fixed inset-0 bg-black/40 z-20"></div>

  <aside
    id="cart-drawer"
    class="fixed top-0 right-0 h-full w-full sm:w-96 bg-white dark:bg-gray-800 shadow-2xl z-30 translate-x-full transition-transform duration-300 flex flex-col"
  >
    <div class="flex items-center justify-between px-4 py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 class="font-semibold text-gray-800 dark:text-gray-100">Keranjang Belanja</h2>
      <button id="cart-close" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-xl">✕</button>
    </div>

    <div id="cart-items" class="flex-1 overflow-y-auto px-4 py-3 space-y-3">
      <!-- item keranjang di-render di sini lewat JS -->
    </div>

    <div class="border-t border-gray-200 dark:border-gray-700 px-4 py-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-500 dark:text-gray-400">Total</span>
        <span id="cart-total" class="font-bold text-lg text-gray-800 dark:text-gray-100">Rp0</span>
      </div>
      <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-lg text-sm">
        Checkout
      </button>
    </div>
  </aside>

  <script>
    window.__INITIAL_PRODUCTS__ = <%- JSON.stringify(products) %>;
  </script>

  <script src="/js/store.js"></script>
  <script src="/js/theme.js"></script>
  <script src="/js/cart.js"></script>
  <script src="/js/wishlist.js"></script>
  <script src="/js/products.js"></script>
</body>
</html>